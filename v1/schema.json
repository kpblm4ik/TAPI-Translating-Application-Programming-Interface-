{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAPI dictionary",
  "type": "object",
  "required": ["version", "dictionary"],
  "properties": {
    "version": { "type": "integer" },
    "dictionary": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["literary_ru", "translation_en"],
        "properties": {
          "literary_ru": { "type": "string" },
          "translation_en": { "type": "string" }
        }
      }
    }
  }
}
